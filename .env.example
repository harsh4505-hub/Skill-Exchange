# ===================================================================
# STUDENT SKILL EXCHANGE PLATFORM - SMTP CONFIGURATION TEMPLATE
# Copy this file to .env and insert your actual SMTP credentials.
# .env is excluded from Git to prevent secret leakage.
# ===================================================================

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM="Student Skill Exchange <noreply@mgmmumbai.ac.in>"
