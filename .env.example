# ===================================================================
# GMAIL SMTP CONFIGURATION (Required for Real Student Email Verification)
# ===================================================================
#
# Instructions:
# 1. Create a copy of this file named ".env" in this directory:
#    copy .env.example .env
#
# 2. Set your authorized Google/Gmail account:
#    MAIL_USERNAME=your-email@gmail.com
#
# 3. Generate a 16-character Google App Password:
#    - Go to Google Account: https://myaccount.google.com/security
#    - Ensure "2-Step Verification" is ON
#    - Search or navigate to "App passwords"
#    - Create an App password (name it "Skill Exchange")
#    - Copy the generated 16-character code (e.g. abcd efgh ijkl mnop)
#    - Paste it below as MAIL_PASSWORD
#
# Note: Never use your regular Google account password.
#       Google requires an App Password with 2-Step Verification.
# ===================================================================

MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# ===================================================================
# SUPABASE CLOUD DATABASE CONFIGURATION
# ===================================================================
SUPABASE_URL=https://qfokonidfrpkunkuivwo.supabase.co
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=

# ===================================================================
# xAI / GROK LEARNING ASSISTANT CONFIGURATION
# ===================================================================
# Obtain an API key from the official xAI Console: https://console.x.ai
# Keep this key strictly secret on the server. Never expose in frontend code.
XAI_API_KEY=
XAI_MODEL=grok-4.7
